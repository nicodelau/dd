# ==============================================================================
# DISCORD BOT CONFIGURATION
# ==============================================================================
# Token secreto de tu bot de Discord (creado en Discord Developer Portal)
DISCORD_TOKEN="tu_token_de_discord_aqui"

# ID del canal de texto que dispara la generación al enviar un mensaje (opcional si usas comandos)
TRIGGER_CHANNEL_ID="123456789012345678"

# URL del Webhook de Discord del canal al que se enviará la imagen generada
DESTINATION_WEBHOOK_URL="https://discord.com/api/webhooks/1234567890/abcdefg..."

# ==============================================================================
# PROVEEDORES DE IA (OPCIÓN GRATIS POR DEFECTO)
# ==============================================================================
# Proveedor de transcripción de voz: "groq" (Gratis) o "openai"
STT_PROVIDER="groq"

# Proveedor de LLM para sintetizar prompts: "groq" (Gratis) o "openai"
LLM_PROVIDER="groq"

# Proveedor de imágenes: "pollinations" (100% Gratis sin API Key) o "dalle3"
IMAGE_PROVIDER="pollinations"

# API Key de Groq (Gratis con límites generosos en https://console.groq.com)
GROQ_API_KEY="gsk_..."

# API Key de OpenAI (Opcional, solo si STT_PROVIDER="openai" o IMAGE_PROVIDER="dalle3")
OPENAI_API_KEY=""

# Tiempo de retención de transcripciones para contexto en segundos (ej. 300 = últimos 5 min)
TRANSCRIPT_RETENTION_SECONDS="300"

# Intervalo para la generación automática de imágenes en segundos (ej. 300 = cada 5 minutos, 0 para desactivar)
AUTO_GENERATE_INTERVAL_SECONDS="300"
