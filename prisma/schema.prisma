// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Auth Info
  email       String   @unique
  password    String
  username    String   @unique
  
  // Profile Info
  firstName   String?
  lastName    String?
  avatar      String?
  bio         String?
  
  // Role Management
  role        UserRole @default(PLAYER)
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  
  // Relationships
  characters  Character[]
  ownedCharacters Character[] @relation("CharacterOwner")
  
  @@map("users")
}

enum UserRole {
  PLAYER
  DM
  ADMIN
}

model Character {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Ownership
  userId      String?   // The player who owns this character
  ownerId     String?   // The DM who created/manages this character
  
  // Basic Info
  name        String
  playerName  String?
  race        String?    // Now optional to allow custom input
  subrace     String?
  class       String?    // Now optional to allow custom input
  level       Int      @default(1)
  background  String?    // Now allows custom input
  alignment   String?    // Now allows custom input
  
  // Character Image
  avatar      String?    // URL or path to character image
  
  // Physical Characteristics
  age         Int?
  height      String?
  weight      String?
  eyes        String?
  skin        String?
  hair        String?

  // Core Stats
  hitPoints      Int @default(0)
  maxHitPoints   Int @default(0)
  tempHitPoints  Int @default(0)
  armorClass     Int @default(10)
  proficiencyBonus Int @default(2)
  speed          Int @default(30)
  initiative     Int @default(0)
  passivePerception Int @default(10)

  // Ability Scores (the 6 main stats)
  strength       Int @default(10)
  dexterity      Int @default(10)
  constitution   Int @default(10)
  intelligence   Int @default(10)
  wisdom         Int @default(10)
  charisma       Int @default(10)

  // Experience and Currency
  experiencePoints Int @default(0)
  copperCoins      Int @default(0)
  silverCoins      Int @default(0)
  electrumCoins    Int @default(0)
  goldCoins        Int @default(0)
  platinumCoins    Int @default(0)

  // Inventory and Equipment
  backpack         String? // Text description of backpack contents
  languages        String? // Known languages

  // Character Details
  inspiration     Boolean @default(false)
  personality     String?
  ideals          String?
  bonds           String?
  flaws           String?
  backstory       String?
  notes           String?

  // Death Saves
  deathSaveSuccesses Int @default(0)
  deathSaveFailures  Int @default(0)

  // Relationships
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  owner           User?         @relation("CharacterOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  savingThrows    SavingThrow[]
  skills          Skill[]
  spells          CharacterSpell[]
  spellSlots      SpellSlot[]
  inventory       InventoryItem[]
  attacks         Attack[]
  features        Feature[]
  cantrips        Cantrip[]
  specialAbilities SpecialAbility[]
  combatActions   CombatAction[]

  @@map("characters")
}

model SavingThrow {
  id           String    @id @default(cuid())
  characterId  String
  ability      String    // "strength", "dexterity", etc.
  proficient   Boolean   @default(false)
  
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, ability])
  @@map("saving_throws")
}

model Skill {
  id           String      @id @default(cuid())
  characterId  String
  name         String      // "Acrobatics", "Animal Handling", etc.
  ability      String      // "strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"
  proficient   Boolean     @default(false)
  expertise    Boolean     @default(false)
  category     SkillCategory @default(OTRO)
  description  String?     // For custom skills, especially "Otro" category
  
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, name])
  @@map("skills")
}

enum SkillCategory {
  DANO    // Damage skills - create attacks
  AYUDA   // Support skills - help allies
  OTRO    // Other skills - general abilities, invocations, etc.
}

model Spell {
  id          String   @id @default(cuid())
  name        String   @unique
  level       Int
  school      String?
  castingTime String?
  range       String?
  components  String?
  duration    String?
  description String?
  
  characters  CharacterSpell[]

  @@map("spells")
}

model CharacterSpell {
  id          String    @id @default(cuid())
  characterId String
  spellId     String
  prepared    Boolean   @default(false)
  known       Boolean   @default(true)
  
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  spell       Spell     @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([characterId, spellId])
  @@map("character_spells")
}

model SpellSlot {
  id           String    @id @default(cuid())
  characterId  String
  level        Int       // 1-9
  total        Int       @default(0)
  used         Int       @default(0)
  
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, level])
  @@map("spell_slots")
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  name        String
  description String?
  quantity    Int       @default(1)
  weight      Float?
  value       Float?
  equipped    Boolean   @default(false)
  
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model Attack {
  id            String    @id @default(cuid())
  characterId   String
  name          String
  attackBonus   Int?
  damageType    String?
  damageDice    String?
  damageBonus   Int?
  range         String?
  description   String?
  sourceSkillId String?   // Reference to the skill that created this attack
  
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("attacks")
}

model Feature {
  id          String    @id @default(cuid())
  characterId String
  name        String
  source      String?   // "Race", "Class", "Background", "Feat"
  description String?
  
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("features")
}

model Cantrip {
  id          String    @id @default(cuid())
  characterId String
  name        String
  description String?
  
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("cantrips")
}

model SpecialAbility {
  id             String    @id @default(cuid())
  characterId    String
  name           String
  diceFormula    String    // e.g., "2d6+3", "1d20", "3d8+5"
  description    String
  usesPerRest    Int?      // optional: limited uses per rest
  usesRemaining  Int?      // current remaining uses
  abilityType    AbilityType @default(ACTION)

  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("special_abilities")
}

model CombatAction {
  id           String    @id @default(cuid())
  characterId  String
  name         String
  type         String    // "Action", "Bonus Action", "Reaction", "Free Action", "Special"
  currentUses  Int       @default(0)
  maxUses      Int       @default(0)
  description  String?

  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("combat_actions")
}

enum AbilityType {
  ACTION
  BONUS_ACTION
  REACTION
  PASSIVE
}
