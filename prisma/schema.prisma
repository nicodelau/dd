generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  email                String                @unique
  password             String
  username             String                @unique
  firstName            String?
  lastName             String?
  avatar               String?
  bio                  String?
  role                 UserRole              @default(PLAYER)
  isActive             Boolean               @default(true)
  lastLoginAt          DateTime?
  battle_participants  battle_participants[]
  ownedCharacters      Character[]           @relation("CharacterOwner")
  characters           Character[]
  dice_rolls           DiceRoll[]
  dice_rooms           DiceRoom[]
  music_tracks         music_tracks[]
  roomParticipations   RoomParticipant[]
  friendshipsInitiated Friendship[]          @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[]          @relation("FriendshipReceiver")
  messagesSent         DirectMessage[]       @relation("MessageSender")
  messagesReceived     DirectMessage[]       @relation("MessageReceiver")

  @@map("users")
}

model Character {
  id                  String                @id @default(cuid())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  name                String
  playerName          String?
  race                String?
  class               String?
  level               Int                   @default(1)
  background          String?
  alignment           String?
  hitPoints           Int                   @default(0)
  maxHitPoints        Int                   @default(0)
  tempHitPoints       Int                   @default(0)
  armorClass          Int                   @default(10)
  proficiencyBonus    Int                   @default(2)
  speed               Int                   @default(30)
  strength            Int                   @default(10)
  dexterity           Int                   @default(10)
  constitution        Int                   @default(10)
  intelligence        Int                   @default(10)
  wisdom              Int                   @default(10)
  charisma            Int                   @default(10)
  experiencePoints    Int                   @default(0)
  inspiration         Boolean               @default(false)
  personality         String?
  ideals              String?
  bonds               String?
  flaws               String?
  backstory           String?
  notes               String?
  deathSaveSuccesses  Int                   @default(0)
  deathSaveFailures   Int                   @default(0)
  ownerId             String?
  userId              String?
  age                 Int?
  avatar              String?
  backpack            String?
  copperCoins         Int                   @default(0)
  electrumCoins       Int                   @default(0)
  eyes                String?
  goldCoins           Int                   @default(0)
  hair                String?
  height              String?
  initiative          Int                   @default(0)
  languages           String?
  passivePerception   Int                   @default(10)
  platinumCoins       Int                   @default(0)
  silverCoins         Int                   @default(0)
  skin                String?
  subrace             String?
  weight              String?
  attacks             Attack[]
  battle_participants battle_participants[]
  cantrips            Cantrip[]
  spells              CharacterSpell[]
  owner               User?                 @relation("CharacterOwner", fields: [ownerId], references: [id])
  user                User?                 @relation(fields: [userId], references: [id])
  combatActions       CombatAction[]
  features            Feature[]
  inventory           InventoryItem[]
  savingThrows        SavingThrow[]
  skills              Skill[]
  specialAbilities    SpecialAbility[]
  spellSlots          SpellSlot[]

  @@map("characters")
}

model SavingThrow {
  id          String    @id @default(cuid())
  characterId String
  ability     String
  proficient  Boolean   @default(false)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, ability])
  @@map("saving_throws")
}

model Skill {
  id          String        @id @default(cuid())
  characterId String
  name        String
  ability     String
  proficient  Boolean       @default(false)
  expertise   Boolean       @default(false)
  category    SkillCategory @default(OTRO)
  description String?
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, name])
  @@map("skills")
}

model Spell {
  id          String           @id @default(cuid())
  name        String           @unique
  level       Int
  school      String?
  castingTime String?
  range       String?
  components  String?
  duration    String?
  description String?
  characters  CharacterSpell[]

  @@map("spells")
}

model CharacterSpell {
  id          String    @id @default(cuid())
  characterId String
  spellId     String
  prepared    Boolean   @default(false)
  known       Boolean   @default(true)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  spell       Spell     @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([characterId, spellId])
  @@map("character_spells")
}

model SpellSlot {
  id          String    @id @default(cuid())
  characterId String
  level       Int
  total       Int       @default(0)
  used        Int       @default(0)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, level])
  @@map("spell_slots")
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  name        String
  description String?
  quantity    Int       @default(1)
  weight      Float?
  value       Float?
  equipped    Boolean   @default(false)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model Attack {
  id            String    @id @default(cuid())
  characterId   String
  name          String
  attackBonus   Int?
  damageType    String?
  damageDice    String?
  damageBonus   Int?
  range         String?
  description   String?
  sourceSkillId String?
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("attacks")
}

model Feature {
  id          String    @id @default(cuid())
  characterId String
  name        String
  source      String?
  description String?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("features")
}

model Cantrip {
  id          String    @id @default(cuid())
  characterId String
  name        String
  description String?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("cantrips")
}

model SpecialAbility {
  id            String      @id @default(cuid())
  characterId   String
  name          String
  diceFormula   String
  description   String
  usesPerRest   Int?
  usesRemaining Int?
  abilityType   AbilityType @default(ACTION)
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("special_abilities")
}

model CombatAction {
  id          String    @id @default(cuid())
  characterId String
  name        String
  type        String
  currentUses Int       @default(0)
  maxUses     Int       @default(0)
  description String?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("combat_actions")
}

model DiceRoom {
  id                String            @id
  code              String            @unique
  name              String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  createdBy         String
  musicState        Json?             @default("{}")
  battle_sessions   battle_sessions?
  dice_rolls        DiceRoll[]
  users             User              @relation(fields: [createdBy], references: [id])
  music_tracks      music_tracks[]
  room_participants RoomParticipant[]

  @@map("dice_rooms")
}

model RoomParticipant {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  joinedAt   DateTime @default(now())
  lastSeen   DateTime @default(now())
  role       String   @default("Player")
  dice_rooms DiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_participants")
}

model DiceRoll {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  timestamp   DateTime @default(now())
  description String?
  total       Int
  data        Json
  dice_rooms  DiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dice_rolls")
}

model battle_participants {
  id              String          @id
  battleId        String
  userId          String?
  characterId     String?
  name            String
  isEnemy         Boolean         @default(false)
  initiative      Int             @default(0)
  initiativeRoll  Int             @default(0)
  hpCurrent       Int
  hpMax           Int
  armorClass      Int
  status          String?
  battle_sessions battle_sessions @relation(fields: [battleId], references: [id], onDelete: Cascade)
  characters      Character?      @relation(fields: [characterId], references: [id])
  users           User?           @relation(fields: [userId], references: [id])
}

model battle_sessions {
  id                  String                @id
  roomId              String                @unique
  isActive            Boolean               @default(false)
  round               Int                   @default(0)
  phase               String                @default("setup")
  battle_participants battle_participants[]
  dice_rooms          DiceRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model music_tracks {
  id            String   @id
  roomId        String
  addedBy       String
  url           String
  title         String
  artist        String?
  thumbnail     String?
  duration      Int?
  isSoundEffect Boolean  @default(false)
  addedAt       DateTime @default(now())
  users         User     @relation(fields: [addedBy], references: [id])
  dice_rooms    DiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

enum UserRole {
  PLAYER
  DM
  ADMIN
}

enum SkillCategory {
  DANO
  AYUDA
  OTRO
}

enum AbilityType {
  ACTION
  BONUS_ACTION
  REACTION
  PASSIVE
}

model Friendship {
  id        String           @id @default(cuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation("FriendshipInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friend    User             @relation("FriendshipReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}

model DirectMessage {
  id             String   @id @default(cuid())
  senderId       String
  receiverId     String
  content        String
  isInvite       Boolean  @default(false)
  inviteRoomCode String?
  createdAt      DateTime @default(now())
  read           Boolean  @default(false)
  sender         User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}
